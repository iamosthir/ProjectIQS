APP_NAME=IQS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Arabic-first, RTL (§0.6 / §0.8)
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=iqslaravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- OTP / SMS (Phase 1) ---
# driver: log (writes code to log for local/CI). Swap for a real SMS gateway later.
OTP_DRIVER=log
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
# Return the OTP in the request-otp response (local/CI ONLY — never in production)
OTP_EXPOSE_CODE=false

# --- Demo admin (seeded by DemoAdminSeeder) ---
ADMIN_EMAIL=admin@iqs.app
ADMIN_PASSWORD=password

# --- Payments (Phase 6) ---
PAYMENT_WINDOW_MINUTES=30

# ZainCash (use the test base URL in non-prod)
ZAINCASH_MERCHANT_ID=
ZAINCASH_SECRET=
ZAINCASH_MSISDN=
ZAINCASH_BASE_URL=https://test.zaincash.iq
ZAINCASH_REDIRECT_URL=

# FIB (First Iraqi Bank) — confirm base URL with onboarding docs
FIB_CLIENT_ID=
FIB_CLIENT_SECRET=
FIB_BASE_URL=https://fib.stage.fib.iq
FIB_CALLBACK_URL=

# --- Push notifications / FCM (Phase 7) ---
# driver: log (local/CI) | kreait (real FCM)
FCM_DRIVER=log
FCM_PROJECT_ID=
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json

# --- API-Football (unified football data sync) ---
# Set the key to activate the automatic sync (admin Sync Console → auto-sync).
API_FOOTBALL_KEY=
API_FOOTBALL_DAILY_LIMIT=100
# Live-score poll cadence: 15 | 30 | 60 seconds.
API_FOOTBALL_LIVE_POLL_SECONDS=30
# Optional auto-sync cadences (minutes unless noted):
# API_FOOTBALL_SYNC_FIXTURES_MINUTES=15
# API_FOOTBALL_SYNC_STANDINGS_MINUTES=60
# API_FOOTBALL_SYNC_TEAMS_MINUTES=1440
# API_FOOTBALL_SYNC_TOP_SCORERS_MINUTES=360
# API_FOOTBALL_SYNC_LINEUP_LOOKAHEAD_MINUTES=60
# API_FOOTBALL_SYNC_LINEUP_RETRY_MINUTES=15
# API_FOOTBALL_SYNC_LIVE_DETAILS_SECONDS=60
